{
  "manifest_version": 3,
  "name": "ChatPanelPlus",
  "version": "0.1.5",
  "description": "ChatGPT上の入力欄へ定型文や現在時刻を挿入し、クリップボードの貼り付けと入力欄のクリアを行います。ボタン・タブの表示、順序、ラベル、色、定型文を設定できます。",
  "permissions": ["clipboardRead", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  }
}
