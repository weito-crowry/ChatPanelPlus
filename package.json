{
  "name": "chatpanelplus",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.30.1"
  },
  "scripts": {
    "build": "pnpm run build:ui",
    "build:ui": "pnpm run build:options && pnpm run build:content && pnpm run build:background && pnpm run build:offscreen",
    "build:options": "vite build --config vite.config.ts",
    "build:content": "vite build --config vite.config.content.ts",
    "build:background": "vite build --config vite.config.background.ts",
    "build:offscreen": "vite build --config vite.config.offscreen.ts",
    "build:noop": "node scripts/build-noop.mjs",
    "deploy:chrome": "pnpm run build && node scripts/deploy-chrome.mjs",
    "typecheck": "tsc --noEmit",
    "check:size": "node scripts/check-source-size.mjs",
    "lint": "pnpm run check:size && eslint .",
    "test": "pnpm run build && node --experimental-strip-types --test tests/*.test.*"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4"
  }
}
